@startuml
title 시퀀스: 스킬 적용 및 데미지/사망 처리 흐름

participant ResultProcessor as "ResultProcessor/SkillResolver"
participant TargetUnit as "TargetUnit"
participant UnitBase as "UnitBase(affected)"
participant Factory as "Factory(Pool)"
participant BattleStage as "BattleStage"

ResultProcessor -> TargetUnit: ApplySkill(skillData)
activate TargetUnit
TargetUnit -> UnitBase: ApplyStatus/ApplyDamage(values)
UnitBase --> TargetUnit: HP updated
alt HP <= 0 (사망)
  TargetUnit -> BattleStage: NotifyDeath(unit)
  activate BattleStage
  BattleStage -> TargetUnit: PlayDeathAnim(FadeOut)
  BattleStage -> Factory: ReleaseUnit(unit)
  Factory --> BattleStage: released
  deactivate BattleStage
  TargetUnit -> ResultProcessor: return death result
else (살아있음)
  TargetUnit -> ResultProcessor: return hit result
end
deactivate TargetUnit

@enduml
