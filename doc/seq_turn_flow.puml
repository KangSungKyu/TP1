@startuml
title 시퀀스: 전체 턴 처리 (readyQueue -> 퍼즐 -> resultQueue -> 루프)

participant BattleLoop as "BattleLoop(Coroutine)"
participant Unit as "UnitBase"
participant ReadyQueue as "readyQueue"
participant PuzzleSystem as "PuzzleSystem"
participant ResultQueue as "resultQueue"
participant ResultProcessor as "ResultProcessor"

loop while isBattleActive
  BattleLoop -> Unit: AddATBTick(dt)
  Unit -> ReadyQueue: if ATBFull enqueue

  alt ReadyQueue not empty
	ReadyQueue -> BattleLoop: Dequeue attacker
	BattleLoop -> Unit: if attacker is PlayerUnit
	alt PlayerUnit
	  BattleLoop -> PuzzleSystem: CreatePuzzle(attacker)
	  PuzzleSystem --> BattleLoop: PuzzleCompleted or Expired
	  BattleLoop -> ResultQueue: Enqueue(result)
	else MonsterUnit
	  BattleLoop -> MonsterUnit: Monster prepares pattern
	  MonsterUnit -> BattleLoop: pattern ready -> Enqueue(result)
	end
  end

  alt ResultQueue not empty
	ResultQueue -> ResultProcessor: Dequeue & Process
	ResultProcessor -> Unit: ApplySkill/ApplyDamage
	ResultProcessor --> BattleLoop: processing complete
  end

  BattleLoop -> BattleLoop: WaitForNextFrame
end

@enduml
